from typing import IO

from reportlab.lib.utils import ImageReader

class Canvas:
    def __init__(
        self,
        filename: str | IO[bytes],
        pagesize: tuple[float, float] | None = None,
        *,
        encrypt: str | None = None,
    ) -> None: ...
    def setFont(self, psfontname: str, size: float, leading: float | None = None) -> None: ...
    def drawString(self, x: float, y: float, text: str) -> None: ...
    def drawImage(
        self,
        image: ImageReader | str,
        x: float,
        y: float,
        width: float | None = None,
        height: float | None = None,
    ) -> object: ...
    def translate(self, dx: float, dy: float) -> None: ...
    def scale(self, x: float, y: float) -> None: ...
    def saveState(self) -> None: ...
    def restoreState(self) -> None: ...
    def beginForm(
        self, name: str, lowerx: float = 0, lowery: float = 0, upperx: float | None = None,
        uppery: float | None = None,
    ) -> None: ...  # fmt: skip
    def endForm(self) -> None: ...
    def doForm(self, name: str) -> None: ...
    def showPage(self) -> None: ...
    def save(self) -> None: ...
