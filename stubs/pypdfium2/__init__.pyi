# Minimal stub for pypdfium2 5.x: only what tenderscreen uses.
from collections.abc import Iterator, Sequence
from os import PathLike

from PIL import Image

class PdfiumError(RuntimeError): ...

class PdfDocument:
    def __init__(
        self,
        input: str | bytes | PathLike[str],
        password: str | None = None,
        autoclose: bool = False,
    ) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def save(self, dest: str | PathLike[str]) -> None: ...
    def close(self) -> None: ...

class PdfPage:
    def get_size(self) -> tuple[float, float]: ...
    def get_bbox(self) -> tuple[float, float, float, float]: ...
    def set_mediabox(self, l: float, b: float, r: float, t: float) -> None: ...
    def get_textpage(self) -> PdfTextPage: ...
    def get_objects(
        self, filter: Sequence[int] | None = None, max_depth: int = 15
    ) -> Iterator[PdfObject]: ...
    def render(
        self,
        scale: float = 1,
        rotation: int = 0,
        *,
        may_draw_forms: bool = True,
        grayscale: bool = False,
    ) -> PdfBitmap: ...
    def close(self) -> None: ...

class PdfTextPage:
    def get_text_bounded(self) -> str: ...
    def close(self) -> None: ...

class PdfObject:
    type: int  # an FPDF_PAGEOBJ_* constant
    level: int  # nesting depth in Form XObjects; 0 = directly on the page
    def get_bounds(self) -> tuple[float, float, float, float]: ...
    def get_matrix(self) -> PdfMatrix: ...

class PdfMatrix:
    def __init__(
        self,
        a: float = 1,
        b: float = 0,
        c: float = 0,
        d: float = 1,
        e: float = 0,
        f: float = 0,
    ) -> None: ...
    def multiply(self, other: PdfMatrix) -> PdfMatrix: ...
    def translate(self, x: float, y: float) -> PdfMatrix: ...
    def on_rect(
        self, left: float, bottom: float, right: float, top: float
    ) -> tuple[float, float, float, float]: ...

class PdfBitmap:
    def to_pil(self) -> Image.Image: ...
    def close(self) -> None: ...
